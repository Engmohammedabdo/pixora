# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_TOPUP_SMALL_PRICE_ID=
STRIPE_TOPUP_MEDIUM_PRICE_ID=
STRIPE_TOPUP_LARGE_PRICE_ID=
STRIPE_TOPUP_XL_PRICE_ID=

# AI APIs
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# AI model overrides (optional) — defaults live in lib/ai/models.ts.
# Set these to swap a model without a code change or redeploy.
# ⚠ Verify any ID against the provider's model list first: an unknown ID fails at
#   runtime, not at build time.
# PYRA_MODEL_GEMINI_IMAGE=gemini-3.1-flash-image
# PYRA_MODEL_GEMINI_IMAGE_PRO=gemini-3-pro-image
# PYRA_MODEL_GEMINI_TEXT=gemini-3.1-flash-lite
# PYRA_MODEL_OPENAI_IMAGE=gpt-image-2
# PYRA_MODEL_OPENAI_TEXT=gpt-5.4-mini
# PYRA_MODEL_OPENAI_TTS=gpt-4o-mini-tts
# PYRA_MODEL_ELEVENLABS=eleven_v3
# PYRA_MODEL_FLUX=black-forest-labs/flux-1.1-pro

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Analytics
# GA4 browser tag. Optional: components/analytics/GoogleAnalytics.tsx falls back to
# a hardcoded measurement id, so production reports without this. Set it locally
# only to test the tag, preferably against a throwaway property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server -> GA4 (Measurement Protocol). NOT derivable from the measurement id.
# Create at: GA4 -> Admin -> Data Streams -> (stream) -> Measurement Protocol API secrets.
# Without it, `purchase` and every other server-sent event is SKIPPED — the
# internal user_events timeline is unaffected, so the symptom is GA4 Monetization
# staying empty while the admin dashboard shows the revenue.
GA4_API_SECRET=
# Declared, empty, and read by no line of code — see CLAUDE.md.
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# ElevenLabs Arabic voice overrides (optional) — defaults in lib/ai/elevenlabs.ts.
# Voice Library voices must be added to your ElevenLabs account before the API
# accepts their IDs. Verify with: GET https://api.elevenlabs.io/v1/voices
# PYRA_VOICE_MALE_GULF=rUaPbzcZIu8df8iNL9WZ
# PYRA_VOICE_FEMALE_GULF=gVzwmdZzRgBrNjXaTmi5
# PYRA_VOICE_MALE_MSA=xvhpbk8otnNHtT3fjCpr
# PYRA_VOICE_FEMALE_MSA=ML7jGRDg4E9hIl5qEm1Z
# PYRA_VOICE_NARRATOR=G1HOkzin3NMwRHSq60UI
# PYRA_VOICE_PREMIUM_MALE=8KMBeKnOSHXjLqGuWsAE
# PYRA_VOICE_PREMIUM_FEMALE=kdUY91gH5xyDHapxlthT

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (app-sent: dunning notices, waitlist confirmation)
#
# Unset is a supported state: lib/email/client.ts logs what it WOULD have sent
# and returns { status: 'skipped' }. Nothing crashes, no send is retried.
#
# EMAIL_FROM must be on a domain verified in Resend, or every send is rejected
# with "domain is not verified" — the first failure everyone hits.
# ─────────────────────────────────────────────────────────────────────────────
# ── Option A (recommended here): your own mail server ───────────────────────
# You already run one — mail.pyramedia.info, Postfix + STARTTLS on 587, paid for
# with the hosting. Its SPF record already authorises it, so sending as
# support@pyramedia.info passes with NO DNS changes and no monthly fee.
# When SMTP_HOST is set it takes priority over Resend.
SMTP_HOST=mail.pyramedia.info
SMTP_PORT=587
SMTP_USER=support@pyramedia.info
SMTP_PASS=

# ── Option B: a hosted provider, if you ever outgrow the above ──────────────
RESEND_API_KEY=
# With your own SMTP the From address IS your real inbox, so replies land there
# with nothing extra to configure. EMAIL_REPLY_TO only matters on a provider,
# where the sending domain has to be one the provider verified.
EMAIL_FROM="PyraSuite <support@pyramedia.info>"
EMAIL_REPLY_TO=

# These DO cover password reset as of 2026-08-23: the app generates the recovery
# link itself (app/api/auth/recover/route.ts) and sends it on this transport, so
# there is one place to configure rather than two. With EMAIL_FROM or the backend
# unset, POST /api/auth/recover returns 503 and the page says so plainly instead of
# claiming a link is on its way.
#
# Still owned by Supabase Auth (GoTrue) and configured with SMTP_* on the SUPABASE
# service: signup confirmation and magic link. Neither is in use — signups are
# auto-confirmed and the magic-link control was removed from the login page.
# See docs/EMAIL_SETUP.md.
