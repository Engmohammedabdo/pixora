{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pyrasuite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "pyrasuite-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "pyrasuite-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3002,
      "autoPort": true
    }
  ]
}
